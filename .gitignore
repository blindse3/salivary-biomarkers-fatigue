# ---------- R session / project files ----------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/

# ---------- renv (if/when added) ----------
# Keep the lockfile and activation script tracked; ignore the local library
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# ---------- Large, fully-reproducible binary outputs ----------
# Figures/tables in Results/ are regenerated by running the scripts in
# Scripts/ — tracking the large TIFF outputs in git bloats repo history
# unnecessarily. CSV outputs are small and kept tracked for easy diffing/
# review without needing to re-run the pipeline.
Results/*.tiff
Results/*.tif
Results/*.png
Results/*.pdf

# ---------- OS junk files ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Editor/IDE ----------
.vscode/
.idea/

# ---------- Miscellaneous ----------
*.log
~$*
